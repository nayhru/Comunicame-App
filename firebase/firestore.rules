rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada persona lee y escribe unicamente su propio documento.
    // request.auth.uid lo pone Firebase Auth, no el cliente: no se puede falsear.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Las frases guardadas cuelgan del usuario que las creo.
    match /usuarios/{uid}/frases/{fraseId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
